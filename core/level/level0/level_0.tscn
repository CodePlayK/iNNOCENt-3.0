},
"31": {
&"character": "我",
&"id": "31",
&"next_id": "32",
&"text": "我…… ……",
&"type": "dialogue"
},
"32": {
&"character": "我",
&"id": "32",
&"next_id": "33",
&"text": "我这是在哪儿?",
&"type": "dialogue"
},
"33": {
&"id": "33",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"34": {
&"id": "34",
