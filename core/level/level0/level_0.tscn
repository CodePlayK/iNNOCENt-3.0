&"text": "siuuuuuuuuuuuu！",
&"type": "dialogue"
},
"27": {
&"character": "bloodking2",
&"id": "27",
&"next_id": "28",
&"text": "siuuu siuuuuuu！",
&"type": "dialogue"
},
"28": {
&"id": "28",
&"is_snippet": false,
&"next_id": "end!",
