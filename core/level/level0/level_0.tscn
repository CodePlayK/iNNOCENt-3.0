&"type": ""
},
"35": {
&"id": "35",
&"next_id": "36",
&"type": "title"
},
"36": {
&"character": "汽车|",
&"id": "36",
&"next_id": "37",
&"text": "一辆腐朽到只剩骨架的汽车残骸.",
&"type": "dialogue"
},
"37": {
&"character": "M|疑惑",
&"id": "37",
&"next_id": "38",
&"text": "汽车?",
&"type": "dialogue"
},
"38": {
&"character": "M",
&"id": "38",
&"next_id": "39",
&"text": "这种东西怎么会出现在楼层中",
&"type": "dialogue"
},
"39": {
&"character": "M",
&"id": "39",
&"next_id": "40",
&"text": "难道……我已经来到了地面上?",
&"type": "dialogue"
},
"4": {
&"id": "4",
&"next_id": "5",
&"type": "title"
},
"40": {
&"character": "我|头痛",
&"id": "40",
&"next_id": "41",
&"text": "…… ……",
&"type": "dialogue"
},
"41": {
&"character": "我",
&"id": "41",
&"next_id": "42",
&"text": "头还是好晕",
&"type": "dialogue"
},
"42": {
&"id": "42",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
"43": {
&"id": "43",
&"next_id": "44",
&"type": ""
},
"44": {
&"id": "44",
&"next_id": "45",
&"type": "title"
},
"45": {
&"character": "bloodking1",
&"id": "45",
&"next_id": "46",
&"text": "呼,终于找到你了[color=ffff00]潜行者[/color].",
&"type": "dialogue"
},
"46": {
&"character": "bloodking1",
&"id": "46",
&"next_id": "47",
&"text": "这该死的降落伞果然不靠谱.",
&"type": "dialogue"
},
"47": {
&"character": "bloodking2",
&"id": "47",
&"next_id": "48",
&"text": "你没事吧?",
&"type": "dialogue"
},
"48": {
&"character": "bloodking2",
&"id": "48",
&"next_id": "49",
&"text": "我们得赶紧去和大部队汇合.",
&"type": "dialogue"
},
"49": {
&"character": "我",
&"id": "49",
&"next_id": "50",
&"text": "…… ……",
&"type": "dialogue"
},
"5": {
&"character": "it",
&"id": "5",
&"next_id": "6",
&"text": "需要我跟你一起走吗~",
&"type": "dialogue"
},
"50": {
&"character": "M",
&"id": "50",
&"next_id": "51",
&"text": "他们认识我？",
&"type": "dialogue"
},
"51": {
&"character": "bloodking1",
&"id": "51",
&"next_id": "52",
&"text": "…… ……？",
&"type": "dialogue"
},
"52": {
&"character": "bloodking1",
&"id": "52",
&"next_id": "53",
&"text": "你不会摔傻了吧？",
&"type": "dialogue"
},
"53": {
&"character": "bloodking1",
&"id": "53",
&"next_id": "54",
&"text": "别愣着，这里不安全。",
&"type": "dialogue"
},
"54": {
&"character": "bloodking2",
&"id": "54",
&"next_id": "55",
&"text": "算了，你就先跟在我们身后。",
&"type": "dialogue"
},
"55": {
&"character": "bloodking1",
&"id": "55",
&"next_id": "56",
&"text": "出发！",
&"type": "dialogue"
},
"56": {
&"id": "56",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
