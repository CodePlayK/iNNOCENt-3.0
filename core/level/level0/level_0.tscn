&"id": "57",
&"next_id": "58",
&"type": ""
},
"58": {
&"id": "58",
&"next_id": "59",
&"type": "title"
},
"59": {
&"character": "我",
&"id": "59",
&"next_id": "60",
&"text": "…… ……",
&"type": "dialogue"
},
"6": {
&"character": "我",
&"id": "6",
&"next_id": "7",
&"responses": PackedStringArray("6", "8"),
&"text": "枪在手跟我走！",
&"type": "response"
},
"60": {
&"character": "我",
&"id": "60",
&"next_id": "61",
&"text": "似乎也没别的路了.",
&"type": "dialogue"
},
"61": {
&"character": "我",
&"id": "61",
&"next_id": "62",
&"text": "就暂且跟过去吧.",
&"type": "dialogue"
},
"62": {
&"id": "62",
&"is_snippet": false,
&"next_id": "end!",
&"next_id_after": "",
&"type": "goto"
},
